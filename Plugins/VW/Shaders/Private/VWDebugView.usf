#include "VWCommon.ush"

Texture2D<float4> SceneColorTex;
Texture2D<float4> SceneDepthTex;
RWTexture2D<float4> Output;
uint DebugMode;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    if (any(DispatchThreadID.xy >= uint2(VWView.ViewSize)))
        return;

    const int2 Pixel = VWView.ViewRectMin + int2(DispatchThreadID.xy);
    const float2 UV = (DispatchThreadID.xy + 0.5) / float2(VWView.ViewSize);
    
    float3 Color = SceneColorTex[Pixel].rgb;
    if (DebugMode == 1)
    {
        Color = GetRayDirUE(UV) * 0.5 + 0.5;
    }
    Output[Pixel] = float4(Color, 1.0);

}