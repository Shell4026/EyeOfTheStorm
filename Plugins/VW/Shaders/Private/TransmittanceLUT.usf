#include "VWAtmosphere.ush"

uint Steps;
RWTexture2D<float4> OutLUT;

float3 Transmittance(float Mu, float Height)
{
	const float SampleDis = VWAtmosphere.GroundRadius + Height;
	const float RayProj = SampleDis * Mu;
	const float D2 = SampleDis * SampleDis - RayProj * RayProj;
	const float R2 = VWAtmosphere.AtmosphereRadius * VWAtmosphere.AtmosphereRadius;
	const float SampleToAtmosphere = sqrt(R2 - D2) - RayProj;
	if (SampleToAtmosphere <= 0.0)
		return 1.0;

	const float StepSize = SampleToAtmosphere / Steps;
	float3 SigmaSum = 0.0;
	for (uint i = 0; i < Steps; ++i)
	{
		const float T = (i + 0.5) * StepSize;
		const float SampleRadius = sqrt(D2 + (RayProj + T) * (RayProj + T));
		const float SampleHeight = SampleRadius - VWAtmosphere.GroundRadius;
		if (SampleHeight < 0.0)
			return 0.0;
		
		SigmaSum += ScatteringCoefficient(SampleHeight) + AbsorptionCoefficient(SampleHeight);
	}
	return exp(-SigmaSum * StepSize);
}

[numthreads(16, 16, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint Width, Height;
	OutLUT.GetDimensions(Width, Height);
	if (DispatchThreadId.x >= Width || DispatchThreadId.y >= Height)
		return;

	float2 UV = (float2(DispatchThreadId.xy) + 0.5) / float2(Width, Height);
	UV.y = 1.0 - UV.y; // 제일 위가 대기 꼭대기

	const float2 MuHeight = GetTransmittanceMuHeight(UV);
	OutLUT[DispatchThreadId.xy] = float4(Transmittance(MuHeight.x, MuHeight.y), 1.0);
}
