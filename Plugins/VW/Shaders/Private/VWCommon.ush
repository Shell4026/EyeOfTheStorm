#pragma once
#include "/Engine/Private/Common.ush"

#define VW_PI 3.14159265359
static const float CLOUD_HEIGHT = 2000.0; // m
static const float CLOUD_THICKNESS = 5000.0; // m

float3 UEToWDir(float3 D)
{
    return float3(D.x, D.z, D.y);
}
float3 WToUEDir(float3 D)
{
    return float3(D.x, D.z, D.y);
}
float3 UEToWPos(float3 P)
{
    return float3(P.x, P.z, P.y) * 0.01;
}
float3 WToUEPos(float3 P)
{
    return float3(P.x, P.z, P.y) * 100.0;
}

float2 ViewUVToNDC(float2 UV)
{
    // UV 좌상단 0, 0
    // 클립 공간 위쪽 +1
    return float2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
}
// 저해상도 텍스처의 픽셀 -> 원본 해상도 SceneTexture 의 픽셀 좌표
int2 ViewUVToScenePixel(float2 UV)
{
    const int2 Local = min(int2(UV * float2(VWView.ViewSize)), VWView.ViewSize - 1);
    return VWView.ViewRectMin + Local;
}
float3 ReconstructCamRelPosUE(float2 UV, float DeviceZ)
{
    const float4 H = mul(float4(ViewUVToNDC(UV), DeviceZ, 1.0), VWView.ClipToCamRel);
    return H.xyz / H.w;
}
float3 GetRayDirUE(float2 UV)
{
    // 메모) 언리얼은 1이 근평면
    return normalize(ReconstructCamRelPosUE(UV, 1.0));
}
float3 GetRayDirW(float2 UV)
{
    return UEToWDir(GetRayDirUE(UV));
}
bool IsSky(float DeviceZ)
{
    return DeviceZ <= 0.0;
}
float GetSurfaceDistanceW(float2 UV, float DeviceZ)
{
    if (IsSky(DeviceZ))
        return 1e10;
    return length(ReconstructCamRelPosUE(UV, DeviceZ)) * 0.01;
}
float3 PlanetCenterW()
{
    return float3(0.0, -VWAtmosphere.GroundRadius, 0.0);
}